# PostgreSQL connection string
# Format: postgresql://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql://username:password@host:5432/database_name
DB_SCHEMA=your_schema_name

# JWT settings
SECRET_KEY=change-this-to-a-long-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Groq chat configuration
LLM_PROVIDER=groq
GROQ_API_KEY=replace-with-groq-api-key
GROQ_MODEL=openai/gpt-oss-20b

# Optional Hugging Face repository embeddings (also accepts legacy LLM_API_KEY)
EMBEDDING_API_KEY=

# AI request limits (0 disables the corresponding limit)
AI_DAILY_REQUEST_LIMIT=120
AI_DAILY_TOKEN_LIMIT=250000
AI_OUTPUT_TOKEN_RESERVATION=512

# AI context and transient-failure handling
AI_CONTEXT_MAX_CHARS=100000
AI_MAX_RETRIES=2
AI_RETRY_BASE_DELAY=0.25
AI_INDEX_MAX_FILE_CHARS=500000
AI_AGENT_MAX_TOOL_CALLS=8
AI_REQUEST_TIMEOUT_SECONDS=60