# PostgreSQL connection string
# Format: postgresql://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql://postgres:dhiva2004@localhost:5432/postgres
DB_SCHEMA=public

# JWT settings
SECRET_KEY=9nGFE2wegCQo45uGP3DtmHX3_9sfjapdocA8R1iVYr8
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Groq chat configuration
LLM_PROVIDER=groq
GROQ_API_KEY="your_groq_api_key_here"
GROQ_MODEL=openai/gpt-oss-20b

# Optional Hugging Face repository embeddings (also accepts legacy LLM_API_KEY)
EMBEDDING_API_KEY=

# AI request limits (0 disables the corresponding limit)
AI_DAILY_REQUEST_LIMIT=120
AI_DAILY_TOKEN_LIMIT=250000
AI_OUTPUT_TOKEN_RESERVATION=512

# AI context and transient-failure handling
AI_CONTEXT_MAX_CHARS=100000
AI_MAX_RETRIES=2
AI_RETRY_BASE_DELAY=0.25
AI_INDEX_MAX_FILE_CHARS=500000
AI_AGENT_MAX_TOOL_CALLS=8
AI_AGENT_MAX_CORRECTION_RETRIES=2
AI_REQUEST_TIMEOUT_SECONDS=60

# Optional offline package caches mounted read-only into the Docker sandbox
SANDBOX_PYTHON_WHEELHOUSE=
SANDBOX_NPM_CACHE=